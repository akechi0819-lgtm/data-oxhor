[Unit]
Description=Shadow BI isolated Superset
After=network.target postgresql.service
Requires=postgresql.service
[Service]
User=shadowbi
Group=shadowbi
WorkingDirectory=/srv/shadow-bi/code
EnvironmentFile=/etc/shadow-bi.env
ExecStart=/srv/shadow-bi/venv/bin/gunicorn --workers 1 --worker-class gthread --threads 3 --timeout 180 --graceful-timeout 180 --bind 127.0.0.1:18090 --access-logfile - --error-logfile - superset.app:create_app()
Restart=on-failure
RestartSec=3
TimeoutStopSec=190
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shadow-bi/app
ReadOnlyPaths=/var/lib/shadow-bi/releases
MemoryMax=4G
TasksMax=128
[Install]
WantedBy=multi-user.target
