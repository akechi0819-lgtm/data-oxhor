[Unit]
Description=Shadow BI fixed batch publisher
After=network.target shadow-bi.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/shadow-bi/code
ExecStart=/usr/local/sbin/shadow-bi-receiver-publish
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shadow-bi /run /etc/shadow-bi.env
TimeoutStartSec=900
UMask=0077
