[Unit]
Description=Fixed raw Excel prepare-only consumer
After=network.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=shadowraw
Group=shadowraw
WorkingDirectory=/srv/shadow-bi/raw-code
ExecStartPre=+/srv/shadow-bi/venv/bin/python -B -m dashboard_product.shadow_bi.p5.raw_context
ExecStart=/srv/shadow-bi/venv/bin/python -B -m dashboard_product.shadow_bi.p5.raw_consumer --policy /var/lib/shadow-bi/raw-control/policy.json
RuntimeDirectory=shadow-bi-raw
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shadow-bi/raw-control /var/lib/shadow-bi/raw-pending /var/lib/shadow-bi/raw-compute /var/lib/shadow-bi/raw-status /run/shadow-bi-raw
InaccessiblePaths=/etc/shadow-bi.env /etc/shadow-bi-receiver.env /var/lib/shadow-bi/notify-control
RestrictAddressFamilies=AF_UNIX
MemoryMax=3G
MemorySwapMax=0
CPUQuota=200%
TasksMax=64
RuntimeMaxSec=1800
TimeoutStartSec=1800
TimeoutStopSec=15
Restart=on-failure
RestartSec=30
