[Unit]
Description=Fixed prepared raw batch publisher
After=shadow-bi.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/srv/shadow-bi/raw-code
ExecStart=/usr/local/sbin/shadow-bi-raw-publish
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/shadow-bi /run
MemoryMax=3G
MemorySwapMax=0
CPUQuota=200%
TasksMax=128
TimeoutStartSec=900
TimeoutStopSec=180
Restart=on-failure
RestartSec=30
UMask=0077
