      "sql_owner": "customer_workspace_saved_query_registry",
      "consumed_by": "refresh.py"
    },
    {
      "query_id": "attributed_passive_reported_cash",
      "version": "v1",
      "purpose": "可复用的逐笔被动新生正向报入现金底稿，保留工单关联状态和归属规则",
      "parameters": ["start_date", "end_date"],
      "output": "cash detail attribution rows",
      "sql_owner": "customer_workspace_saved_query_registry",
      "consumed_by": "manual analysis; not used by refresh.py"
